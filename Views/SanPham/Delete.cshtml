@model ShoppingWeb.Models.SanPham
@{ ViewData["Title"] = "Xóa sản phẩm"; }

<h1>Xóa sản phẩm</h1>
<h4 class="text-danger">Bạn có chắc muốn xóa sản phẩm này?</h4>
<hr />
<dl class="row">
    <dt class="col-sm-2">Mã</dt>
    <dd class="col-sm-10">@Model.Ma</dd>

    <dt class="col-sm-2">Tên</dt>
    <dd class="col-sm-10">@Model.Ten</dd>

    <dt class="col-sm-2">Giá</dt>
    <dd class="col-sm-10">@(Model.Gia?.ToString("N0")) đ</dd>

    <dt class="col-sm-2">Danh mục</dt>
    <dd class="col-sm-10">@Model.DanhMuc?.Ten</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Ma" />
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>